datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  publicKey     String    // PEM-encoded RSA public key
  contacts      Int[]     // Array of contact user IDs
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Message {
  id               Int      @id @default(autoincrement())
  senderId         Int
  recipientId      Int
  encryptedContent String   // ✅ Contenido cifrado con AES
  encryptedKey     String   // ✅ Llave AES cifrada con RSA del destinatario
  iv               String   // ✅ Vector de inicialización
  signature        String   // ✅ Firma digital del remitente
  timestamp        DateTime @default(now())
  sender            User     @relation("SentMessages", fields: [senderId], references: [id])
  recipient         User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
}